  "comparisons": [
    {
      "id": "VIS-01",
      "atlasId": "ATL-001",
      "title": "Shared openable list rows",
      "providers": [
        "Loki",
        "Tempo"
      ],
      "category": "List composition",
      "question": "Should Logs, Patterns and Tempo use shared open/focus/chevron chrome while keeping their distinct density, data and virtualization?",
      "evidenceGap": "Interaction and keyboard parity require native assertions; the sheet alone cannot prove them.",
      "images": [
        {
          "role": "left",
          "asset": "audit/compare-lists.png"
        },
        {
          "role": "right",
          "asset": "loki-log-patterns.png"
        }
      ]
    },
    {
      "id": "VIS-02",
      "atlasId": "ATL-002",
      "title": "Nested Settings Escape",
      "providers": [
        "Shared",
        "Loki"
      ],
      "category": "Dialogs and focus",
      "question": "Should Escape dismiss only the topmost child selector and preserve the Settings dialog?",
      "evidenceGap": "A static frame cannot demonstrate actual Escape propagation; use CAP-29 and Phase 1B native event ledgers.",
      "images": [
        {
          "role": "left",
          "asset": "audit/nested-settings-escape-desktop.png"
        },
        {
          "role": "right",
          "asset": "audit/compare-dialogs.png"
        }
      ]
    },
    {
      "id": "VIS-03",
      "atlasId": "ATL-003",
      "title": "Connection-dialog keyboard policy",
      "providers": [
        "Shared",
        "PostgreSQL"
      ],
      "category": "Dialogs and focus",
      "question": "Should connection pickers/forms trap Tab, handle Escape and return focus to their invoking controls, with Delete-return focus separately owned?",
      "evidenceGap": "Delete focus is CAP-02 direct evidence, not a V-03 screenshot; screenshots show shell only.",
      "images": [
        {
          "role": "left",
          "asset": "audit/compare-dialogs.png"
        },
        {
          "role": "right",
          "asset": "ai-settings.png"
        }
      ]
    },
    {
      "id": "VIS-04",
      "atlasId": "ATL-004",
      "title": "Tempo narrow toolbar",
      "providers": [
        "Tempo"
      ],
      "category": "Responsive layout",
      "question": "Should Tempo inner-toolbar actions wrap or collapse based on pane width rather than viewport width?",
      "evidenceGap": "Compare native narrow capture and standard builder; quantify overflow in the linked evidence.",
