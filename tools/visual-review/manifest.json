    {
      "id": "VIS-05",
      "atlasId": "ATL-006",
      "title": "Retained results after failed query",
      "providers": [
        "PostgreSQL",
        "Shared"
      ],
      "category": "Failure and recovery",
      "question": "When a query fails, should previous settled Table and Chart results both remain visible, or both hide with an explicit stale-result indicator?",
      "evidenceGap": "The result-retention discrepancy is policy-unresolved. Screens show state; retained rows also require the execution ledger.",
