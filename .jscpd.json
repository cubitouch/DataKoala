{
  "path": ["src"],
  "format": ["typescript", "tsx"],
  "minLines": 10,
  "minTokens": 70,
  "mode": "mild",
  "kind": ["exact"],
  "threshold": 100,
  "reporters": ["console"],
  "output": "reports/duplication",
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.vitest.ts",
    "**/*.vitest.tsx",
    "**/*.e2e.ts",
    "**/*.e2e.tsx",
    "**/testUtils.ts",
    "**/*TestUtils.ts",
    "**/test-utils.ts",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/testdata/**",
    "**/fixtures/**",
    "**/fixture/**",
    "**/generated/**",
    "**/*.generated.ts",
    "**/*.generated.tsx",
    "**/*.d.ts",
    "**/out/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/screenshots/**"
  ]
}
