{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/src/main.tsx",
    "src/renderer/src/preload.d.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/renderer/src/test/**",
    "!src/**/*.vitest.ts"
  ],
  "include": [
    "files"
  ],
  "ignore": [
    "src/renderer/src/lib/explorationPresets/**"
  ]
}
